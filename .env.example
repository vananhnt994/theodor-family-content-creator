# =============================================================================
# Theodor Family Content Creator - Umgebungsvariablen Template
# Kopiere diese Datei nach .env und trage deine echten API-Schlüssel ein:
#   cp .env.example .env
# =============================================================================

# 1. LLM APIs (Skripterstellung & Trendanalyse)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Alternative falls GOOGLE_API_KEY verwendet wird
GOOGLE_API_KEY=

# 2. Text-to-Speech (Audio-Generierung)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# 3. Optional: OpenAI (Fallback für Vision / LLM)
OPENAI_API_KEY=your_openai_api_key_here

# 4. Google Cloud Platform (Vertex AI Imagen 3)
GOOGLE_PROJECT_ID=your_gcp_project_id_here
GOOGLE_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# 5. Cloud-Archivierung (Google Drive)
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# 6. Social Media Uploader (Optional)
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_token_here

# 7. Monitoring & Observability (Optional)
PUSHGATEWAY_URL=http://admin:password@localhost:9091
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PROMETHEUS_URL=http://prometheus:9090
